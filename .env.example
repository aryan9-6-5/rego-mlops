# Rego — Environment Variables Template
# Copy this to .env and fill in the values.
# NEVER commit the actual .env file.

# --- Backend (FastAPI) ---
ENVIRONMENT=development
LOG_LEVEL=info

# LLM (OpenRouter)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_DEFAULT_MODEL=google/gemini-2.0-pro-exp-02-05:free
LLM_FALLBACK_MODEL=anthropic/claude-3-haiku

# Supabase (Backend)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Neo4j (Knowledge Graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# MLflow (Tracking)
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=rego-compliance

# CI gates and CT
MODEL_ARTIFACT_DIR=artifacts/models
GITHUB_TOKEN=
GITHUB_REPOSITORY=
CT_WORKFLOW_FILE=ct.yml
CT_WORKFLOW_REF=main
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_TRAIN_DATASET=

# Security
PROOF_CERT_SECRET=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
